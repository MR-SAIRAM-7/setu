{
  "name": "setu",
  "private": true,
  "version": "0.9.0",
  "description": "SETU — the Cognitive Bridge. One engine, three surfaces.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "//": "These go through scripts/workspace.mjs rather than turbo or a nested `pnpm -r`, both of which need a pnpm binary on PATH. On a machine using corepack's shim there isn't one, and the failure looks nothing like the cause. turbo.json is still here — use the turbo:* scripts if you want its caching.",
    "dev": "node scripts/workspace.mjs dev --parallel",
    "build": "node scripts/workspace.mjs build",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "test": "node scripts/workspace.mjs test",
    "turbo:build": "turbo run build",
    "turbo:typecheck": "turbo run typecheck",
    "eval": "tsx evals/run.ts",
    "ext:build": "node scripts/workspace.mjs build --filter @setu/extension",
    "ext:zip": "node scripts/workspace.mjs build --filter @setu/extension && node scripts/zip-extension.mjs",
    "edge:dev": "node scripts/workspace.mjs dev --filter @setu/web",
    "edge:build": "node scripts/workspace.mjs build --filter @setu/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "printWidth": 100,
    "trailingComma": "all"
  }
}
