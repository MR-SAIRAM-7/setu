# ─────────────────────────────────────────────────────────────────────────────
# SETU EDGE (apps/web)  —  server-only secrets. Never ship these to a client.
# ─────────────────────────────────────────────────────────────────────────────

# L2 / L3 rungs of the Compute Ladder. Required for any cloud AI.
GOOGLE_GENERATIVE_AI_API_KEY=

# Fallback rung. Optional — the chain degrades gracefully without it.
GROQ_API_KEY=

# Model IDs. Override if Google renames or you want to pin a version.
SETU_MODEL_FLASH=gemini-2.5-flash
SETU_MODEL_FLASH_LITE=gemini-2.5-flash-lite
SETU_MODEL_PRO=gemini-2.5-pro
SETU_MODEL_EMBED=gemini-embedding-001

# Auth mode:
#   'open'     — no auth, per-device rate limit. Use for local dev + hackathon demo.
#   'supabase' — require a Supabase bearer token. Use once Sanctuary auth exists.
SETU_AUTH_MODE=open

# Supabase (only needed when SETU_AUTH_MODE=supabase, or for the Vault later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS allowlist for the extension. Comma-separated Chrome extension IDs.
# Find yours at chrome://extensions after loading unpacked.
# NEVER set this to '*'.
SETU_ALLOWED_EXTENSION_IDS=

# Salt for the (future) anonymised Open Barrier Ledger path hashing.
SETU_BARRIER_SALT=

# Rate limits (per identity)
SETU_RATE_PER_MIN=30
SETU_RATE_PER_DAY=300

# ─────────────────────────────────────────────────────────────────────────────
# SETU LENS (apps/extension)  —  build-time, PUBLIC. Nothing secret here, ever.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SETU_API_BASE=http://localhost:3000
