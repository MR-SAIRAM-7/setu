# ==============================================================================
# SETU Sanctuary — Environment Configuration
# Copy to .env and configure OPENROUTER_API_KEY (or GEMINI_API_KEY) & MONGODB_URI.
# ==============================================================================

# --- Primary AI Provider: OpenRouter -----------------------------------------
# Get your API Key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Preferred primary model. If it hits rate limits (429), balance limits (402), or errors,
# the engine automatically falls back down the OPENROUTER_MODEL_CHAIN.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional comma-separated list of fallback models in priority order:
OPENROUTER_MODEL_CHAIN=google/gemini-2.5-flash,anthropic/claude-3.5-haiku,meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat,openai/gpt-4o-mini,mistralai/mistral-small-24b-instruct-2501

# OpenRouter Application Metadata (Sent with request headers)
OPENROUTER_APP_NAME="SETU Cognitive Sanctuary"
OPENROUTER_SITE_URL="https://setu-sanctuary.app"

# --- Secondary & Tertiary Direct AI Fallbacks ---------------------------------
# Google Gemini Direct (secondary fallback). Free key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI Direct (tertiary fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MongoDB Database Persistence ---------------------------------------------
# MongoDB URI for local or cloud persistence (conversations, messages, files, mindmaps).
# Example Local: mongodb://127.0.0.1:27017/setu
# Example Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/setu?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/setu

# --- Engine Configuration -----------------------------------------------------
PORT=3000
NODE_ENV=development

# Per-request AI timeout and retry budget
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
AI_MAX_RETRY_WAIT_MS=15000

# --- Web App ------------------------------------------------------------------
# Only needed in production when frontend and backend are hosted on separate domains.
# In development, Vite automatically proxies /api requests to localhost:PORT.
VITE_API_URL=
