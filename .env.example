# ==============================================================================
# NeuroBridge One (SETU) Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# Google Gemini API Key (Free tier AI Provider - Recommended)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative AI Provider)
OPENAI_API_KEY=

# OpenAI Model Choice (Default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
