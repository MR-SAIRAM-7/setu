# ==============================================================================
# SETU Sanctuary — Environment Configuration
# Copy to .env and configure OPENROUTER_API_KEY (or GEMINI_API_KEY) & MONGODB_URI.
# ==============================================================================

# --- Primary AI Provider: OpenRouter -----------------------------------------
# Get your API Key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Preferred primary model. (e.g. google/gemma-4-26b-a4b-it:free)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Optional comma-separated list of fallback models in priority order:
OPENROUTER_MODEL_CHAIN=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3.5-lightning:free,openrouter/free,openai/gpt-oss-20b:free

# OpenRouter Real-time Web Search Tool (Set to 'false' to disable)
OPENROUTER_WEB_SEARCH=true

# OpenRouter Application Metadata (Sent with request headers)
OPENROUTER_APP_NAME="SETU Cognitive Sanctuary"
OPENROUTER_SITE_URL="https://setu-sanctuary.app"

# --- Secondary & Tertiary Direct AI Fallbacks ---------------------------------
# Google Gemini Direct (secondary fallback). Free key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI Direct (tertiary fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Read-aloud voice: Sarvam AI ----------------------------------------------
# Powers every "read to me" surface with a natural human voice. This matters
# more than it sounds: audio is the primary comprehension accommodation for
# readers who struggle to decode text, and a robotic voice is materially harder
# to follow. Get a key at https://dashboard.sarvam.ai/
#
# Leave blank and SETU falls back to the browser's built-in speech synthesis —
# everything still works, it just sounds worse.
SARVAM_API_KEY=

# bulbul:v3 is the natural-prosody model; bulbul:v2 is the legacy one.
# Speaker names are NOT shared between versions — v3 has priya/ritu/neha/kavya…,
# v2 has anushka/manisha/vidya/arya. A mismatched pair is repaired at runtime.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TIMEOUT_MS=30000

# Default conversation language. Users override this per-browser in Settings;
# this is only the starting point. One of:
#   en-IN  hi-IN  bn-IN  gu-IN  kn-IN  ml-IN  mr-IN  od-IN  pa-IN  ta-IN  te-IN
# It sets both the language the AI answers in and the language audio is
# synthesised in — see backend/config/languages.js.
SARVAM_TTS_LANGUAGE=en-IN

# --- MongoDB Database Persistence ---------------------------------------------
# MongoDB URI for local or cloud persistence (conversations, messages, files, mindmaps).
# Leave blank to run fully in local/browser fallback mode without MongoDB.
# Example Local: mongodb://127.0.0.1:27017/setu
# Example Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/setu?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/setu

# Database used when the URI carries no path of its own — Atlas copies the
# connection string as ".../?appName=Cluster0", which would otherwise land
# everything in "test" instead of alongside the rest of your data.
MONGODB_DB=setu

# Resolvers used for the SRV/TXT lookup that mongodb+srv:// requires. Many home
# routers and office networks answer A records but refuse SRV queries, which the
# driver reports as "querySrv ECONNREFUSED" — it looks like a dead cluster but is
# only DNS. These are tried when the system resolver fails; blank disables them.
DNS_SERVERS=8.8.8.8,1.1.1.1

# How long to wait for a server to be selected before falling back (ms).
MONGODB_TIMEOUT_MS=15000

# Set to true to skip MongoDB entirely and run on local fallback storage.
MONGODB_DISABLED=false

# --- Engine Configuration -----------------------------------------------------
PORT=3000
NODE_ENV=development

# Per-request AI timeout and retry budget
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
AI_MAX_RETRY_WAIT_MS=15000

# --- Security -----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Leave blank to reflect any origin (fine locally; set it in production).
# The Chrome extension is always allowed regardless of this setting.
# Example: CORS_ORIGINS=https://setu-sanctuary.app,https://www.setu-sanctuary.app
CORS_ORIGINS=

# Serve the built web app (frontend/dist) from the API process.
# Set to false when the frontend is hosted separately, e.g. on Vercel's CDN.
SERVE_STATIC=true

# Per-user request budgets. AI routes are limited separately because they cost quota.
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_MS=60000

# --- Demo Data ----------------------------------------------------------------
# User id the seed script writes under: npm run seed
SEED_USER_ID=demo_user

# --- Web App ------------------------------------------------------------------
# Only needed in production when frontend and backend are hosted on separate domains.
# In development, Vite automatically proxies /api requests to localhost:PORT.
VITE_API_URL=
