# ==============================================================================
# SETU — Environment Configuration
# Copy to .env and fill in at least GEMINI_API_KEY.
# ==============================================================================

# --- AI providers -------------------------------------------------------------

# Google Gemini (primary). Free key: https://aistudio.google.com/
# Free tier allows 20 requests/minute and does not include Search grounding.
GEMINI_API_KEY=

# Optional: pin a specific model. Leave blank to let the engine walk its
# fallback chain and cache whichever model answers first.
GEMINI_MODEL=

# OpenAI (optional fallback, used only if Gemini fails or is unset).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Engine -------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Per-request AI timeout and retry budget.
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_MAX_RETRY_WAIT_MS=20000

# --- Web app ------------------------------------------------------------------

# Only needed in production. In dev, Vite proxies /api to PORT above.
VITE_API_URL=

# --- MongoDB Database Persistence ---------------------------------------------
# Optional: Set MongoDB URI for cloud/local database persistence.
# If left blank, the app runs smoothly with its high-performance browser LocalStorage layer.
MONGODB_URI=mongodb://127.0.0.1:27017/setu
