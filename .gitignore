# Dependencies
node_modules/
.pnpm-store/
package-lock.json

# Build outputs
dist/
build/
.next/
out/

# Environment variables
# Ignore all .env files across all directories, keeping only .env.example templates
.env
.env.*
.env.local
**/.env
**/.env.*
**/.env.local
!**/.env.example
!**/.env.local.example

# System and logs
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Antigravity / IDE artifacts
.idea/
.vscode/
*.swp
*.swo
scratch/


# Extension signing keys — never commit these
*.pem
