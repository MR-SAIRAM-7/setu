# ==============================================================================
# SETU Backend — Environment Configuration
# Copy to .env and set GEMINI_API_KEY & MONGODB_URI. Nothing else is required.
#
# The backend also reads the repository-root .env, so you can keep one file at
# the root instead of two. Values here win when both are present.
# ==============================================================================

# --- AI Provider: Google Gemini -----------------------------------------------
# Create a key at https://aistudio.google.com/apikey
#
# IMPORTANT: a Google AI Pro / Google One AI Premium subscription is a consumer
# plan for the Gemini app. It does NOT grant Gemini API access. The API key is
# separate, is created in AI Studio, and has its own free tier. For paid-tier
# throughput and no daily cap, enable Cloud Billing on the Google Cloud project
# the key belongs to.
GEMINI_API_KEY=

# Preferred model. Leave blank to use the top of the chain below.
# Retired IDs (gemini-1.5-*, gemini-2.0-*) are ignored with a warning — Google
# has switched them off, so a request to one is a guaranteed 404.
GEMINI_MODEL=

# Everyday chain, tried in order. Used for every request a human is waiting on.
GEMINI_MODEL_CHAIN=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

# Deep chain, for research and mind-map structuring. Falls through to the chain
# above when these are unavailable.
GEMINI_PRO_MODEL=
GEMINI_PRO_MODEL_CHAIN=gemini-3.1-pro-preview,gemini-2.5-pro

# How much the model may reason before answering: minimal | low | medium | high.
GEMINI_THINKING_LEVEL=low
GEMINI_PRO_THINKING_LEVEL=high

# Google Search grounding for the research pass. Costs quota per grounded call.
GEMINI_WEB_SEARCH=true

# Ask the API which models this key can reach, at boot, and skip the rest.
GEMINI_DISCOVER_MODELS=true

# Override only for a proxy or a regional endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Optional last-resort fallback --------------------------------------------
# Unset in most deployments. It exists so a Gemini outage degrades to a slower
# answer rather than to no answer at all.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Read-aloud voice & STT: Sarvam AI ----------------------------------------
# Leave blank to fall back to the browser's built-in speech synthesis.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_TIMEOUT_MS=30000

# --- MongoDB Database Persistence ---------------------------------------------
# Leave blank to run on local fallback storage without MongoDB.
# Example Local: mongodb://127.0.0.1:27017/setu
# Example Atlas: mongodb+srv://<user>:<pass>@cluster0.abcde.mongodb.net/setu?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/setu
MONGODB_DB=setu
MONGODB_DISABLED=false
MONGODB_TIMEOUT_MS=15000

# Resolvers for the SRV/TXT lookup mongodb+srv:// requires. Many home and office
# networks answer A records but refuse SRV queries, which the driver reports as
# "querySrv ECONNREFUSED" — it looks like a dead cluster but is only DNS.
DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Engine Configuration -----------------------------------------------------
PORT=3000
NODE_ENV=development

# Ceiling on one HTTP call to a model.
AI_TIMEOUT_MS=45000

# Ceiling on one logical request — the whole chain walk, retries included. This
# is the number a user actually experiences; no caller can exceed it.
AI_DEADLINE_MS=90000

# Retries per provider. Small on purpose: the model chain is already the
# redundancy, so retrying only pays for transient 429s and 5xx.
AI_MAX_RETRIES=2
AI_MAX_RETRY_WAIT_MS=8000

# Set to 1 to print per-stage AI timings, for telling a slow model apart from a
# chain walk when a request feels slow.
SETU_AI_TRACE=0

# --- Security -----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Blank reflects any
# origin (fine locally; set it in production). Extensions are always allowed.
CORS_ORIGINS=

# Serve the built web app (frontend/dist) from this process. Set to false when
# the frontend is hosted separately.
SERVE_STATIC=true

# Per-user request budgets. AI routes are metered separately because they cost quota.
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_MS=60000

# --- Demo Data ----------------------------------------------------------------
# User id the seed script writes under: npm run seed
SEED_USER_ID=demo_user
