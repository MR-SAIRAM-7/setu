# ==============================================================================
# SETU Backend — Environment Configuration
# ==============================================================================

# OpenRouter Primary API Key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL_CHAIN=google/gemini-2.5-flash,anthropic/claude-3.5-haiku,meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat,openai/gpt-4o-mini

# Google Gemini Direct (Secondary Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI Direct (Tertiary Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/setu

# Engine Port
PORT=3000
NODE_ENV=development
