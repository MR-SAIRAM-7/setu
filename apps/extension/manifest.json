{
  "manifest_version": 3,
  "name": "SETU Lens — the cognitive bridge",
  "version": "1.0.0",
  "description": "Turns overwhelming pages into calm, clear next steps. From overwhelm to action.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "contextMenus", "tts"],
  "optional_permissions": ["tabCapture"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SETU — open the panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-focus": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle Focus Mode"
    },
    "panic": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Show me only the next step"
    },
    "commander": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Voice command"
    },
    "demo-mode": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle demo mode (local fixtures, no network)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
