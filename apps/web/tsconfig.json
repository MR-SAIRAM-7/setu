{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // Re-declared because `baseUrl` in an extended config resolves relative to
    // the BASE file's directory, not this one.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@setu/core": ["../../packages/core/src/index.ts"],
      "@setu/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
