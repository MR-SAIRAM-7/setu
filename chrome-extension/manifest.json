{
  "manifest_version": 3,
  "name": "SETU Lens — Cognitive Accessibility",
  "version": "3.0.0",
  "description": "Reshape any website for how your brain actually reads. Bionic text, line focus, read aloud, and an AI agent that navigates pages for you.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SETU Lens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/setu-core.js",
        "content/bionic-reading.js",
        "content/focus-mode.js",
        "content/line-focus.js",
        "content/word-highlight.js",
        "content/text-to-speech.js",
        "content/auto-scroll.js",
        "content/eye-tracker.js",
        "content/dyslexia-theme.js",
        "content/breathe-protocol.js",
        "content/task-chunker.js",
        "content/visual-breakdown.js",
        "content/sanctuary-bridge.js",
        "content/agent-copilot.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "shared/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-bionic": {
      "suggested_key": { "default": "Alt+B" },
      "description": "Toggle Bionic Reading"
    },
    "toggle-focus": {
      "suggested_key": { "default": "Alt+F" },
      "description": "Toggle Focus Mode"
    },
    "toggle-linefocus": {
      "suggested_key": { "default": "Alt+L" },
      "description": "Toggle Line Focus"
    },
    "open-commander": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open SETU Commander"
    },
    "toggle-tts": {
      "description": "Toggle Read Aloud"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
