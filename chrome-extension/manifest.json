{
  "manifest_version": 3,
  "name": "NeuroBridge One — SETU Lens",
  "version": "2.5.0",
  "description": "A unified cognitive accessibility layer that converts digital overwhelm into structured, actionable next steps.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/bionic-reading.js",
        "content/focus-mode.js",
        "content/eye-tracker.js",
        "content/auto-scroll.js",
        "content/text-to-speech.js",
        "content/word-highlight.js",
        "content/dyslexia-theme.js",
        "content/breathe-protocol.js",
        "content/task-chunker.js",
        "content/commander.js",
        "content/visual-breakdown.js",
        "content/sanctuary-bridge.js",
        "content/agent-copilot.js",
        "content/main.js"
      ],
      "css": [
        "styles/bionic-reading.css",
        "styles/focus-mode.css",
        "styles/dyslexia-theme.css",
        "styles/eye-tracker.css",
        "styles/word-highlight.css",
        "styles/setu-overlay.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "styles/*",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-bionic": {
      "suggested_key": { "default": "Alt+B" },
      "description": "Toggle Bionic Reading"
    },
    "toggle-focus": {
      "suggested_key": { "default": "Alt+F" },
      "description": "Toggle Focus Mode"
    },
    "toggle-scroll": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Toggle Auto Scroll"
    },
    "toggle-tts": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Toggle Text to Speech"
    },
    "open-commander": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open NeuroBridge Commander"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
